<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AniRankApp.ViewModels"
             x:Class="AniRankApp.Views.RegisterView"
             x:DataType="vm:RegisterViewModel"
             Shell.NavBarIsVisible="False"
             Title="Registracija">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="24,48" Spacing="14" VerticalOptions="Center" MaximumWidthRequest="420">

                <Image Source="logo.png"
                       WidthRequest="72"
                       HeightRequest="72"
                       HorizontalOptions="Center"
                       SemanticProperties.Description="AniRank logo" />

                <Label Text="Kreiraj nalog"
                       Style="{StaticResource Hero}"
                       HorizontalOptions="Center"
                       SemanticProperties.HeadingLevel="Level1" />

                <Label Text="Treba ti samo korisničko ime, email i lozinka."
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       Margin="0,0,0,12"
                       Style="{StaticResource Caption}" />

                <Entry x:Name="UsernameEntry"
                       Placeholder="Korisničko ime"
                       Text="{Binding Username}"
                       ReturnType="Next"
                       Completed="OnUsernameCompleted"
                       SemanticProperties.Description="Korisničko ime" />

                <Entry x:Name="EmailEntry"
                       Placeholder="Email"
                       Keyboard="Email"
                       Text="{Binding Email}"
                       ReturnType="Next"
                       Completed="OnEmailCompleted"
                       SemanticProperties.Description="Email" />

                <Grid ColumnDefinitions="*,Auto" BackgroundColor="{StaticResource CardBackground}">
                    <Entry x:Name="PasswordEntry"
                           Grid.Column="0"
                           Placeholder="Lozinka (min. 6 karaktera)"
                           IsPassword="True"
                           Text="{Binding Password}"
                           ReturnType="Next"
                           Completed="OnPasswordCompleted"
                           SemanticProperties.Description="Lozinka" />
                    <Button x:Name="PasswordToggle"
                            Grid.Column="1"
                            Style="{StaticResource IconButton}"
                            Text="{StaticResource IconVisibility}"
                            Clicked="OnTogglePasswordClicked"
                            SemanticProperties.Description="Prikaži lozinku" />
                </Grid>

                <Entry x:Name="ConfirmEntry"
                       Placeholder="Potvrdi lozinku"
                       IsPassword="True"
                       Text="{Binding ConfirmPassword}"
                       ReturnType="Done"
                       ReturnCommand="{Binding RegisterCommand}"
                       SemanticProperties.Description="Potvrda lozinke" />

                <Label Text="{Binding ErrorMessage}"
                       TextColor="{StaticResource DangerText}"
                       IsVisible="{Binding ErrorMessage, Converter={StaticResource NotEmpty}}" />

                <Label Text="{Binding SuccessMessage}"
                       TextColor="{StaticResource ScoreHigh}"
                       IsVisible="{Binding SuccessMessage, Converter={StaticResource NotEmpty}}" />

                <Grid Margin="0,6,0,0">
                    <Button Text="Registruj se"
                            Command="{Binding RegisterCommand}"
                            IsEnabled="{Binding IsNotBusy}" />
                    <ActivityIndicator IsRunning="{Binding IsBusy}"
                                       IsVisible="{Binding IsBusy}"
                                       Color="White"
                                       HeightRequest="22"
                                       WidthRequest="22"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                </Grid>

                <Button Text="Već imaš nalog? Prijavi se"
                        Style="{StaticResource LinkButton}"
                        Command="{Binding GoToLoginCommand}" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
