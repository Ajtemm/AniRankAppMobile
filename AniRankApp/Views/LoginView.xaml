<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AniRankApp.ViewModels"
             x:Class="AniRankApp.Views.LoginView"
             x:DataType="vm:LoginViewModel"
             Shell.NavBarIsVisible="False"
             Title="Prijava">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="24,48" Spacing="14" VerticalOptions="Center" MaximumWidthRequest="420">

                <Image Source="logo.png"
                       WidthRequest="88"
                       HeightRequest="88"
                       HorizontalOptions="Center"
                       SemanticProperties.Description="AniRank logo" />

                <Label Text="AniRank"
                       Style="{StaticResource Hero}"
                       FontSize="34"
                       HorizontalOptions="Center"
                       SemanticProperties.HeadingLevel="Level1" />

                <Label Text="Ocenjuj anime, prati prijatelje, otkrij šta je top."
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       Margin="0,0,0,12"
                       Style="{StaticResource Caption}" />

                <Entry x:Name="UsernameEntry"
                       Placeholder="Korisničko ime"
                       Text="{Binding Username}"
                       ReturnType="Next"
                       Completed="OnUsernameCompleted"
                       SemanticProperties.Description="Korisničko ime" />

                <!-- Password + show/hide toggle -->
                <Grid ColumnDefinitions="*,Auto" BackgroundColor="{StaticResource CardBackground}">
                    <Entry x:Name="PasswordEntry"
                           Grid.Column="0"
                           Placeholder="Lozinka"
                           IsPassword="True"
                           Text="{Binding Password}"
                           ReturnType="Done"
                           ReturnCommand="{Binding LoginCommand}"
                           SemanticProperties.Description="Lozinka" />
                    <Button x:Name="PasswordToggle"
                            Grid.Column="1"
                            Style="{StaticResource IconButton}"
                            Text="{StaticResource IconVisibility}"
                            Clicked="OnTogglePasswordClicked"
                            SemanticProperties.Description="Prikaži lozinku" />
                </Grid>

                <Label Text="{Binding ErrorMessage}"
                       TextColor="{StaticResource DangerText}"
                       IsVisible="{Binding ErrorMessage, Converter={StaticResource NotEmpty}}" />

                <Grid Margin="0,6,0,0">
                    <Button Text="Prijavi se"
                            Command="{Binding LoginCommand}"
                            IsEnabled="{Binding IsNotBusy}" />
                    <ActivityIndicator IsRunning="{Binding IsBusy}"
                                       IsVisible="{Binding IsBusy}"
                                       Color="White"
                                       HeightRequest="22"
                                       WidthRequest="22"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                </Grid>

                <Button Text="Nemaš nalog? Registruj se"
                        Style="{StaticResource LinkButton}"
                        Command="{Binding GoToRegisterCommand}" />

                <!-- Shown only in Debug builds (see code-behind) -->
                <Label x:Name="DemoHint"
                       Text="Demo admin nalog:  admin  /  admin123"
                       IsVisible="False"
                       HorizontalOptions="Center"
                       Style="{StaticResource Caption}" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
