<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AniRankApp.ViewModels"
             x:Class="AniRankApp.Views.UserProfileView"
             x:DataType="vm:UserProfileViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Border Style="{StaticResource ReviewCardStyle}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Korisnik" Style="{StaticResource Caption}" />
                    <Label Text="{Binding Username}" FontSize="22" FontAttributes="Bold" />

                    <Label Text="{Binding Role, StringFormat='Uloga: {0}'}" />
                    <Label Text="{Binding JoinedText}" Style="{StaticResource Caption}" />

                    <HorizontalStackLayout Spacing="16">
                        <Label Text="{Binding FollowerCount, StringFormat='Pratilaca: {0}'}" />
                        <Label Text="{Binding FollowingCount, StringFormat='Prati: {0}'}" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="6">
                        <Border Style="{StaticResource StatusBadgeStyle}" IsVisible="{Binding FollowsMe}">
                            <Label Style="{StaticResource StatusBadgeLabelStyle}" Text="Prati te" />
                        </Border>
                        <Border Style="{StaticResource BanBadgeStyle}" IsVisible="{Binding IsPrivateProfile}">
                            <Label Style="{StaticResource BanBadgeLabelStyle}" Text="Privatan profil" />
                        </Border>
                    </HorizontalStackLayout>

                    <Button Text="{Binding FollowActionText}"
                            IsVisible="{Binding IsSelf, Converter={StaticResource Invert}}"
                            Command="{Binding ToggleFollowCommand}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding ErrorMessage}"
                   TextColor="{StaticResource ScoreLow}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource NotEmpty}}" />

            <!-- ===== Private profile: nothing below is shown without permission ===== -->
            <Border Style="{StaticResource FilterCardStyle}"
                    IsVisible="{Binding CanSeeList, Converter={StaticResource Invert}}">
                <Label Text="{Binding PrivacyNotice}" />
            </Border>

            <!-- ===== Watch-status breakdown - tap a row to see those reviews ===== -->
            <Label Text="Lista po statusu"
                   Style="{StaticResource SectionTitle}"
                   IsVisible="{Binding CanSeeList}" />
            <Label Text="Dodirni status da vidiš recenzije sa ovog profila."
                   Style="{StaticResource Caption}"
                   IsVisible="{Binding CanSeeList}" />

            <Border Style="{StaticResource ReviewCardStyle}"
                    IsVisible="{Binding CanSeeList}">
                <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding StatusBreakdown}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:StatusCountItem">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Padding="0,10">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnStatusTapped" />
                                </Grid.GestureRecognizers>

                                <Label Grid.Column="0" Text="{Binding Status}" VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="{Binding Count}"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center"
                                       TextColor="{StaticResource PrimaryAccent}" />
                                <Label Grid.Column="2"
                                       Text="›"
                                       FontSize="18"
                                       VerticalOptions="Center"
                                       TextColor="{StaticResource Gray400}" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </Border>

            <Button Text="{Binding ReviewCount, StringFormat='Sve recenzije ({0})'}"
                    Style="{StaticResource SubtleButton}"
                    IsVisible="{Binding CanSeeList}"
                    Command="{Binding OpenAllReviewsCommand}" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
