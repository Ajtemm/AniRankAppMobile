<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AniRankApp.ViewModels"
             xmlns:model="clr-namespace:AniRankApp.Models"
             xmlns:controls="clr-namespace:AniRankApp.Controls"
             x:Class="AniRankApp.Views.TopListView"
             x:DataType="vm:TopListViewModel"
             Shell.NavBarIsVisible="False"
             Title="Top lista">

    <Grid RowDefinitions="Auto,Auto,*" Padding="16,12,16,0" RowSpacing="10" MaximumWidthRequest="960">

        <VerticalStackLayout Grid.Row="0" Spacing="0" Margin="0,8,0,0">
            <Label Text="Top lista" Style="{StaticResource Hero}" SemanticProperties.HeadingLevel="Level1" />
            <Label Text="Rangirano po ocenama korisnika AniRank-a, ne po Kitsu oceni."
                   Style="{StaticResource Caption}" />
        </VerticalStackLayout>

        <!-- Ranking mode (best rated / most popular): one tap, no dialog -->
        <controls:ChipGroup Grid.Row="1"
                            ItemsSource="{Binding SortOptions}"
                            SelectedItem="{Binding SelectedSortOption}" />

        <RefreshView Grid.Row="2"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding LoadCommand}">

            <CollectionView x:Name="TopList"
                            ItemsSource="{Binding Items}"
                            SelectionMode="Single"
                            SelectionChanged="OnItemSelected">

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="model:CommunityRankItem">
                        <Border Style="{StaticResource ReviewCardStyle}" Padding="10">
                            <Grid ColumnDefinitions="40,60,*,Auto" ColumnSpacing="12">

                                <!-- Rank number; gold / silver / bronze for the podium -->
                                <Label Grid.Column="0"
                                       Text="{Binding Rank}"
                                       FontFamily="PoppinsBold"
                                       FontSize="22"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       TextColor="{StaticResource Gray400}"
                                       SemanticProperties.Description="{Binding Rank, StringFormat='Mesto {0}'}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding Medal}" Value="Gold">
                                            <Setter Property="TextColor" Value="#F5C542" />
                                            <Setter Property="FontSize" Value="26" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding Medal}" Value="Silver">
                                            <Setter Property="TextColor" Value="#C9CED6" />
                                            <Setter Property="FontSize" Value="24" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding Medal}" Value="Bronze">
                                            <Setter Property="TextColor" Value="#D4915A" />
                                            <Setter Property="FontSize" Value="24" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>

                                <Border Grid.Column="1" Style="{StaticResource PosterClip}">
                                    <Image Source="{Binding ImageUrl}"
                                           Aspect="AspectFill"
                                           HeightRequest="84"
                                           WidthRequest="60"
                                           SemanticProperties.Description="{Binding Title, StringFormat='Poster: {0}'}" />
                                </Border>

                                <VerticalStackLayout Grid.Column="2" Spacing="4" VerticalOptions="Center">
                                    <Label Text="{Binding Title}"
                                           Style="{StaticResource CardTitle}"
                                           MaxLines="2"
                                           LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding VotesText}" Style="{StaticResource Caption}" />
                                </VerticalStackLayout>

                                <Border Grid.Column="3" Style="{StaticResource ScoreBadgeStyle}" Padding="10,6">
                                    <Label Style="{StaticResource ScoreBadgeLabelStyle}" FontSize="15">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span FontFamily="Icons" Text="{StaticResource IconStar}" />
                                                <Span Text="{Binding Average, StringFormat=' {0:0.0}'}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <controls:EmptyState x:DataType="vm:TopListViewModel"
                                         IsVisible="{Binding IsNotBusy}"
                                         Glyph="{StaticResource IconTrophy}"
                                         Title="Top lista je još prazna"
                                         Message="Oceni anime koje si gledao i pomozi da se lista popuni."
                                         ActionText="Istraži anime"
                                         ActionCommand="{Binding GoToExploreCommand}" />
                </CollectionView.EmptyView>

            </CollectionView>
        </RefreshView>

        <controls:ErrorBanner Grid.Row="0" Grid.RowSpan="3" Margin="-4,0,-4,12" Message="{Binding ErrorMessage}" />

    </Grid>

</ContentPage>
