<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:AniRankApp"
             xmlns:conv="clr-namespace:AniRankApp.Converters"
             x:Class="AniRankApp.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
                <ResourceDictionary Source="Resources/Styles/CustomStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:NotEmptyBoolConverter x:Key="NotEmpty" />
            <conv:InvertedBoolConverter x:Key="Invert" />
            <conv:InitialsConverter x:Key="Initials" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
