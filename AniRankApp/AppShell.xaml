<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:AniRankApp.Views"
       x:Class="AniRankApp.AppShell"
       Shell.FlyoutBehavior="Disabled"
       Shell.BackgroundColor="{StaticResource PageBackground}"
       Shell.ForegroundColor="{StaticResource TextPrimary}"
       Shell.TitleColor="{StaticResource TextPrimary}"
       Shell.TabBarBackgroundColor="{StaticResource CardBackground}"
       Shell.TabBarForegroundColor="{StaticResource PrimaryAccent}"
       Shell.TabBarTitleColor="{StaticResource PrimaryAccent}"
       Shell.TabBarUnselectedColor="{StaticResource Gray400}"
       Shell.UnselectedColor="{StaticResource Gray400}"
       Title="AniRank">

    <!-- ============ AUTH (no tab bar) ============ -->
    <ShellContent x:Name="LoginItem"
                  Route="login"
                  Shell.TabBarIsVisible="False"
                  ContentTemplate="{DataTemplate views:LoginView}" />

    <ShellContent x:Name="RegisterItem"
                  Route="register"
                  Shell.TabBarIsVisible="False"
                  ContentTemplate="{DataTemplate views:RegisterView}" />

    <!-- ============ MAIN NAVIGATION: bottom tabs on Android, top tabs on Windows ============ -->
    <TabBar x:Name="MainTabs">

        <Tab x:Name="ExploreItem" Title="Istraži" Route="explore" Icon="{StaticResource TabIconExplore}">
            <ShellContent ContentTemplate="{DataTemplate views:ExploreView}" />
        </Tab>

        <Tab x:Name="CommunityTab" Title="Zajednica" Route="community" Icon="{StaticResource TabIconCommunity}">
            <ShellContent ContentTemplate="{DataTemplate views:CommunityView}" />
        </Tab>

        <Tab Title="Top lista" Route="toplist" Icon="{StaticResource TabIconTop}">
            <ShellContent ContentTemplate="{DataTemplate views:TopListView}" />
        </Tab>

        <Tab Title="Profil" Route="profile" Icon="{StaticResource TabIconProfile}">
            <ShellContent ContentTemplate="{DataTemplate views:ProfileView}" />
        </Tab>

        <!-- Visible only for the Admin role -->
        <Tab x:Name="AdminTab" Title="Admin" Route="admin" Icon="{StaticResource TabIconAdmin}" IsVisible="{Binding IsAdmin}">
            <ShellContent ContentTemplate="{DataTemplate views:AdminView}" />
        </Tab>

        <!-- Confirmation page instead of an action tab: cancelling tab navigation is not reliable on Windows -->
        <Tab x:Name="LogoutTab" Title="Odjava" Route="logout" Icon="{StaticResource TabIconLogout}">
            <ShellContent ContentTemplate="{DataTemplate views:LogoutView}" />
        </Tab>

    </TabBar>

</Shell>
